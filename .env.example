# Base URL of the Omeka S REST API (no trailing slash)
OMEKA_API_URL=https://www.goudatijdmachine.nl/omeka/api

# API key of an Omeka user (Admin -> Users -> edit user -> "API keys" tab)
OMEKA_KEY_IDENTITY=
OMEKA_KEY_CREDENTIAL=

# Set to 1 to register only the read tools, even with a write-capable key
OMEKA_READ_ONLY=0

# Milliseconds to wait before the read-back after a write (replica lag)
OMEKA_READBACK_DELAY_MS=1500
